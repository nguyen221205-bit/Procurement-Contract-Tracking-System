{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=procurement_db;User Id=sa;Password=YOUR_STRONG_PASSWORD;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_STRONG_JWT_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "ProcurementSystem",
    "Audience": "ProcurementSystemClient",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderEmail": "noreply@procurementsystem.com",
    "SenderName": "Hệ thống Đấu Thầu & Hợp Đồng",
    "Username": "your_email@gmail.com",
    "Password": "your_app_password"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "StorageSettings": {
    "Provider": "Local",
    "Supabase": {
      "Endpoint": "https://[YOUR_PROJECT_REF].storage.supabase.co/storage/v1/s3",
      "BucketName": "procurement-documents",
      "AccessKeyId": "YOUR_S3_ACCESS_KEY_ID",
      "SecretAccessKey": "YOUR_S3_SECRET_ACCESS_KEY",
      "Region": "ap-southeast-1"
    },
    "Encryption": {
      "Enabled": true,
      "MasterKey": "YOUR_256_BIT_BASE64_MASTER_KEY_HERE"
    }
  }
}