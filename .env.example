# ==============================================================================
# MẪU CẤU HÌNH MÔI TRƯỜNG BACKEND (.env.example - AN TOÀN ĐỂ COMMIT LÊN GIT)
# Hướng dẫn: Sao chép tệp này thành ".env" ở thư mục gốc dự án rồi điền giá trị.
# Hệ thống Backend (Program.cs), DbTool và Backup Script sẽ tự động nạp tệp .env.
# ==============================================================================

ASPNETCORE_ENVIRONMENT=Development

# 1. CƠ SỞ DỮ LIỆU SQL SERVER (API, Migration, Backup/Restore & DbTool)
# Lưu ý: Sửa Server (ví dụ .\SQLEXPRESS), User Id và Password theo SQL Server trên máy của bạn
ConnectionStrings__DefaultConnection=Server=localhost;Database=procurement_db;User Id=sa;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;

# 2. XÁC THỰC JWT (Tối thiểu 32 ký tự - bắt buộc cho Đăng nhập & Refresh Token)
JwtSettings__SecretKey=YOUR_STRONG_JWT_SECRET_KEY_AT_LEAST_32_CHARS
JwtSettings__Issuer=ProcurementSystem
JwtSettings__Audience=ProcurementSystemClient
JwtSettings__ExpirationInMinutes=60
JwtSettings__RefreshTokenExpirationInDays=7

# 3. EMAIL SMTP (Bắt buộc cho Gửi OTP Đăng ký, Mời thành viên & Email cảnh báo hợp đồng)
# Nếu dùng Gmail, sử dụng Google App Password (16 ký tự)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__SenderEmail=your_email@gmail.com
Smtp__SenderName=Hệ thống Đấu Thầu & Hợp Đồng
Smtp__Username=your_email@gmail.com
Smtp__Password=your_gmail_app_password

# 4. ĐƯỜNG DẪN FRONTEND & CORS (SignalR, CORS & liên kết mời thành viên trong email)
FrontendUrl=http://localhost:5173
ClientApp__BaseUrl=http://localhost:5173
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000

# 5. LƯU TRỮ TỆP ĐÍNH KÈM (Mặc định Local; đổi Provider=Supabase nếu dùng Supabase S3)
# Lưu ý: Nếu nhiều máy dùng chung 1 bucket Supabase, phải dùng chung StorageSettings__Encryption__MasterKey (Base64 32 bytes)
StorageSettings__Provider=Local
StorageSettings__Encryption__Enabled=true
# StorageSettings__Encryption__MasterKey=YOUR_256_BIT_BASE64_MASTER_KEY
# StorageSettings__Supabase__Endpoint=https://[YOUR_PROJECT_REF].storage.supabase.co/storage/v1/s3
# StorageSettings__Supabase__BucketName=procurement-documents
# StorageSettings__Supabase__AccessKeyId=YOUR_S3_ACCESS_KEY_ID
# StorageSettings__Supabase__SecretAccessKey=YOUR_S3_SECRET_ACCESS_KEY
# StorageSettings__Supabase__Region=ap-southeast-1
